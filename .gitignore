# NEEDLE execution traces are local diagnostics.
**/.beads/traces/

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/

# Local Ansible inventory and host variables may contain addresses or secrets.
ansible/inventory/hosts.yml
ansible/group_vars/*.yml
!ansible/group_vars/*.example.yml

# SOPS plaintext working files are ignored; only files carrying the explicit
# .sops suffix may be committed under the secrets tree.
/secrets/*/*.env
/secrets/*/*.yaml
/secrets/*/*.yml
!/secrets/*/*.sops.env
!/secrets/*/*.sops.yaml
!/secrets/*/*.sops.yml
