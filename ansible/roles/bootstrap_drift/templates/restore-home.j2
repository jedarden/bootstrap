#!/usr/bin/env bash
set -euo pipefail

source /etc/restic/b2.env
snapshot="${1:-}"
if [[ -z "$snapshot" ]]; then
    restic snapshots
    read -r -p "Enter snapshot ID to restore (or 'latest'): " snapshot
fi
[[ -n "$snapshot" ]] || { echo "No snapshot specified." >&2; exit 1; }
read -r -p "Restore $snapshot into / and overwrite /home? [y/N]: " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || exit 0
systemctl stop tailscaled 2>/dev/null || true
restic restore "$snapshot" --target /
for user_home in /home/*; do
    [[ -d "$user_home" ]] || continue
    user=$(basename "$user_home")
    chown -R "$user:$user" "$user_home"
done
systemctl start tailscaled 2>/dev/null || true
