# Copy this file to the repository root as .sops.yaml after replacing both
# placeholders with real age PUBLIC recipients. Never put an age private
# identity here.
creation_rules:
  - path_regex: ^secrets/bootstrap/.*\.sops\.env$
    age: >-
      REPLACE_WITH_PRIMARY_AGE_RECIPIENT,
      REPLACE_WITH_OFFLINE_RECOVERY_AGE_RECIPIENT
  - path_regex: ^secrets/ansible/.*\.sops\.(yaml|yml)$
    age: >-
      REPLACE_WITH_PRIMARY_AGE_RECIPIENT,
      REPLACE_WITH_OFFLINE_RECOVERY_AGE_RECIPIENT
